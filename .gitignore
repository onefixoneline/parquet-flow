.gradle
**/build/
!**/src/**/build/

# IntelliJ IDEA / JetBrains IDEs
.idea/
.intellijPlatform/
*.iml

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrapper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# Local scratch files: manual test datasets and Marketplace screenshots
large_test_25k.parquet
screenshot.png
test_sample_arrow.arrow
test_sample_feather.feather